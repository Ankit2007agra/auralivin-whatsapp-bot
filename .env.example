# ---- Meta WhatsApp Cloud API ----
# From developers.facebook.com > Your App > WhatsApp > API Setup
WHATSAPP_TOKEN=your_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_API_VERSION=v21.0

# A string you make up yourself. Enter the SAME value when you configure
# the webhook in Meta's App Dashboard ("Verify token" field).
WEBHOOK_VERIFY_TOKEN=choose_a_random_secret_string

# ---- Shopify (for order notifications) ----
# Shopify Admin > Settings > Notifications > Webhooks > Signing secret
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_signing_secret_here

# ---- Shopify (for LIVE order status / tracking replies) ----
# Optional. Without these two set, the bot just replies "our team will
# check that order" when a customer asks for tracking. With them set, it
# looks up the real order in Shopify and replies with the actual status
# and tracking link automatically.
#
# Get the token from: Shopify Admin > Settings > Apps and sales channels
# > Develop apps > Create an app > Configure Admin API scopes (enable
# "read_orders") > Install app > reveal "Admin API access token".
SHOPIFY_STORE_DOMAIN=yiu5wf-1t.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_your_admin_api_token_here

# ---- App ----
PORT=3000

# Comma-separated phone numbers (with country code, no +) that should get an
# internal WhatsApp copy of new orders, e.g. the store owner's own number.
STORE_OWNER_WHATSAPP_NUMBERS=919520666401
